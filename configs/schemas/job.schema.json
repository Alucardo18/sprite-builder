{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprite-builder.local/schemas/job.schema.json",
  "title": "Sprite Builder JobSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job",
    "character",
    "animation",
    "generation",
    "render",
    "alignment",
    "export"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "job": {
      "type": "object",
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}}
    },
    "character": {
      "type": "object",
      "required": ["id", "bible"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "bible": {"type": "string"},
        "references": {"type": "array", "items": {"type": "string"}}
      }
    },
    "animation": {
      "type": "object",
      "required": ["name", "directions", "frame_count"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "directions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["up", "down", "left", "right", "up_left", "up_right", "down_left", "down_right"]
          }
        },
        "frame_count": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "loop": {"type": "boolean"},
        "phases": {"type": "array", "items": {"type": "string"}}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_size"],
      "properties": {
        "source_size": {"$ref": "#/$defs/positivePair"},
        "quality": {"enum": ["low", "medium", "high", "auto"]},
        "mode": {"const": "sheet", "default": "sheet"},
        "candidates_per_sheet": {"type": "integer", "minimum": 1, "maximum": 8},
        "sheet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "layout": {"enum": ["horizontal", "vertical", "grid"]},
            "rows": {"type": "integer", "minimum": 0},
            "columns": {"type": "integer", "minimum": 0},
            "gutter_px": {"type": "integer", "minimum": 0}
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {"type": "string", "minLength": 1},
            "pixel_language": {"type": "string", "minLength": 1},
            "camera": {"type": "string", "minLength": 1},
            "palette": {"type": "string", "minLength": 1},
            "lighting": {"type": "string", "minLength": 1},
            "identity": {"type": "string", "minLength": 1},
            "animation": {"type": "string", "minLength": 1},
            "negative": {"type": "string", "minLength": 1}
          }
        },
        "background": {
          "type": "object",
          "properties": {
            "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
            "mode": {
              "enum": ["chroma", "transparent_preferred", "transparent_required"]
            },
            "fallback": {
              "enum": ["strict_chroma", "manual_ui", "manual_review", "reject"]
            },
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
            "max_alpha_retries": {"type": "integer", "minimum": 0, "maximum": 2}
          }
        }
      }
    },
    "render": {
      "type": "object",
      "required": ["cell_size", "target_body_height_px"],
      "properties": {
        "cell_size": {"$ref": "#/$defs/positivePair"},
        "target_body_height_px": {"type": "integer", "minimum": 1},
        "palette_lock": {"type": "boolean"},
        "dithering": {"type": "boolean"},
        "integrated_shadow": {"type": "boolean"},
        "palette_max_delta_e00": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "resampling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "legacy",
                  "premultiplied_area",
                  "premultiplied_lanczos",
                  "pixel_majority",
                  "edge_aware"
                ]
              }
            },
            "selection": {
              "enum": [
                "auto",
                "legacy",
                "premultiplied_area",
                "premultiplied_lanczos",
                "pixel_majority",
                "edge_aware"
              ]
            },
            "save_variants": {"type": "boolean"}
          }
        }
      }
    },
    "alignment": {
      "type": "object",
      "required": ["method", "canonical_canvas_anchor"],
      "properties": {
        "method": {"const": "torso_hybrid_v1"},
        "canonical_canvas_anchor": {"$ref": "#/$defs/positivePair"},
        "confidence_review_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "allow_manual_override": {"type": "boolean"}
      }
    },
    "export": {
      "type": "object",
      "required": ["formats", "output_dir"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["individual", "horizontal", "grid", "godot"]}
        },
        "output_dir": {"type": "string"},
        "godot": {
          "type": "object",
          "properties": {
            "project_root": {"type": "string"},
            "resource_dir": {"type": "string", "pattern": "^res://"}
          }
        }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_export_on_review": {"type": "boolean", "default": true},
        "alpha_integrity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_transparent_ratio": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
            "min_border_transparent_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "max_foreground_border_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "alpha_threshold": {"type": "integer", "minimum": 0, "maximum": 254}
          }
        },
        "semantic_integrity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "alpha_threshold": {"type": "integer", "minimum": 0, "maximum": 254},
            "body_roi_x": {"$ref": "#/$defs/fractionRange"},
            "min_bottom_gutter_px": {"type": "integer", "minimum": 0},
            "support_band_height_px": {"type": "integer", "minimum": 2},
            "required_support_components": {"type": "integer", "minimum": 1},
            "max_support_y_jitter_px": {"type": "number", "minimum": 0},
            "max_terminal_taper_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "runtime_preview_scales": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "positivePair": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "items": false
    },
    "fractionRange": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false
    }
  }
}
