{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprite-builder.local/schemas/character-bible.schema.json",
  "title": "Sprite Builder Character Bible",
  "type": "object",
  "required": ["schema_version", "character_id", "identity", "palette", "visual_rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "character_id": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "required": ["name", "archetype", "immutable_features", "forbidden_changes"]
    },
    "proportions": {"type": "object"},
    "palette": {
      "type": "object",
      "required": ["file", "locked", "tolerance_delta_e00"]
    },
    "visual_rules": {"type": "object"},
    "equipment": {"type": "object"},
    "anchors": {"type": "object"},
    "scale_profile": {
      "type": "object",
      "required": [
        "reference_animation",
        "status",
        "target_body_height_px",
        "measurement",
        "exclude_from_measurement",
        "tolerance_px"
      ],
      "properties": {
        "reference_animation": {"const": "idle"},
        "status": {"enum": ["pending_idle_approval", "approved"]},
        "target_body_height_px": {"type": ["integer", "null"], "minimum": 1},
        "reference_path": {"type": ["string", "null"]},
        "canonical_anchor": {
          "type": ["array", "null"],
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "items": false
        },
        "measurement": {"const": "robust_body_without_equipment"},
        "exclude_from_measurement": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "tolerance_px": {"type": "number", "minimum": 0}
      }
    }
  }
}
